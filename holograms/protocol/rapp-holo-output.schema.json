      "type": "object",
      "additionalProperties": false,
      "required": [
        "duration_ms",
        "repeat",
        "tracks",
        "flipbook"
      ],
      "properties": {
        "duration_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60000
        },
        "repeat": {
          "enum": [
            "hold",
            "once",
            "loop",
            "ping-pong"
          ]
        },
        "tracks": {
          "type": "array",
          "maxItems": 512,
          "items": {
            "$ref": "#/$defs/track"
          }
        },
        "flipbook": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/flipbookEntry"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "repeat": {
                "const": "hold"
              }
            }
          },
          "then": {
            "properties": {
              "duration_ms": {
                "const": 0
              },
              "tracks": {
                "maxItems": 0
              },
              "flipbook": {
                "maxItems": 0
              }
            }
          },
          "else": {
            "properties": {
              "duration_ms": {
                "minimum": 1
              }
            }
          }
        }
      ]
    },
