{
  "name": "rapterbox-holo-zoo",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "sync:holo": "node scripts/sync-holo-assets.mjs",
    "generate:brand": "node scripts/generate-brand-assets.mjs",
    "prestart": "npm run sync:holo",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "preexport:web": "npm run sync:holo",
    "export:web": "expo export --platform web",
    "postexport:web": "node scripts/release-gate.mjs --exported",
    "gate:simulator-bundle": "node scripts/release-gate.mjs --native-bundle .derived-data-release/Build/Products/Release-iphonesimulator/HoloZoo.app/main.jsbundle",
    "gate:testflight-app": "node scripts/testflight-artifact-gate.mjs",
    "prelint": "npm run sync:holo",
    "lint": "expo lint",
    "pretypecheck": "npm run sync:holo",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run sync:holo",
    "test": "tsx --test src/__tests__/*.test.ts",
    "release:gate": "node scripts/release-gate.mjs && node scripts/release-gate.mjs --self-test"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "57.0.15",
    "expo-constants": "~57.0.13",
    "expo-dev-client": "57.0.14",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.5",
    "expo-linking": "57.0.7",
    "expo-router": "~57.0.15",
    "expo-secure-store": "57.0.1",
    "expo-sharing": "~57.0.14",
    "expo-splash-screen": "~57.0.7",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-purchases": "10.7.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "tweetnacl": "1.0.3"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "@types/react": "~19.2.4",
    "eslint": "^9.0.0",
    "eslint-config-expo": "57.0.1",
    "tsx": "^4.20.0",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}
