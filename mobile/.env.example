# RevenueCat public platform SDK keys are injected at build time.
# Never commit real values.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=

# Public URL/model only. Never place a shared provider API key in Expo env.
EXPO_PUBLIC_RAPTERBOX_WILD_BRAINSTEM_URL=
EXPO_PUBLIC_RAPTERBOX_WILD_MODEL=rapterbox-managed
EXPO_PUBLIC_RAPTERBOX_WILD_LEDGER_URL=
EXPO_PUBLIC_RAPTERBOX_CAPSULE_SERVICE_URL=
EXPO_PUBLIC_RAPTERBOX_CREDIT_REGISTRY_URL=
EXPO_PUBLIC_RAPTERBOX_BTC_SPOT_URL=
